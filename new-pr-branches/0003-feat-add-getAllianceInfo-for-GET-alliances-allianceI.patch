From 9b987f33700471cdc4910d9f515fa2cf652bb341 Mon Sep 17 00:00:00 2001
From: "copilot-swe-agent[bot]" <198982749+Copilot@users.noreply.github.com>
Date: Wed, 25 Mar 2026 21:23:22 +0000
Subject: [PATCH] feat: add getAllianceInfo for GET /alliances/{allianceId}
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The gameinfo API exposes an alliance endpoint that was not implemented.
Returns alliance data including name, tag, founder, founded date, and
list of member guilds.

Exports each function on its own line to prevent future merge conflicts.

Closes #7 — supersedes PR #12
---
 lib/index.js | 37 ++++++++++++++++++++++++++++++++-----
 1 file changed, 32 insertions(+), 5 deletions(-)

diff --git a/lib/index.js b/lib/index.js
index e35c156..3dd3620 100644
--- a/lib/index.js
+++ b/lib/index.js
@@ -207,6 +207,20 @@ function getGuildFued(guildId1, guildId2, cb) {
   baseRequest(`/guilds/${guildId1}/fued/${guildId2}`, cb);
 }
 
+// -- Alliance
+//
+
+/**
+ * getAllianceInfo - Get alliance information by alliance ID
+ *
+ * @param  {string} allianceId The ID of the alliance to retrieve
+ * @param  {callback} cb         Callback function (error, allianceData)
+ */
+function getAllianceInfo(allianceId, cb) {
+  // https://gameinfo.albiononline.com/api/gameinfo/alliances/SUFF0LbNS2GRL4_NIBAaYw
+  baseRequest(`/alliances/${allianceId}`, cb);
+}
+
 // -- Player
 //
 
@@ -309,9 +323,22 @@ function getBattleDetails(battleId, cb) {
 module.exports = {
   search,
   getServerStatus,
-  getRecentKills, getKillDetails, getPlayerFued,
-  getRecentEvents, getEventDetails, getEventsBetween,
-  getGuildInfo, getGuildData, getGuildTopKills, getGuildStats, getGuildMembers, getGuildFued,
-  getPlayerInfo, getPlayerSoloKills, getPlayerTopKills,
-  getRecentBattles, getBattleDetails
+  getRecentKills,
+  getKillDetails,
+  getPlayerFued,
+  getRecentEvents,
+  getEventDetails,
+  getEventsBetween,
+  getGuildInfo,
+  getGuildData,
+  getGuildTopKills,
+  getGuildStats,
+  getGuildMembers,
+  getGuildFued,
+  getAllianceInfo,
+  getPlayerInfo,
+  getPlayerSoloKills,
+  getPlayerTopKills,
+  getRecentBattles,
+  getBattleDetails,
 };
